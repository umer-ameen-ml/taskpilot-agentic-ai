# Copy this file to .env and fill in your own values. Never commit .env.

# LLM (default: OpenRouter)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.5-flash-lite
OPENROUTER_MAX_TOKENS=4092

# Optional: use Gemini instead
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Tools
DUFFEL_ACCESS_TOKEN=
TAVILY_API_KEY=
OPENWEATHER_API_KEY=

# Email (Gmail App Password, not your normal password)
SMTP_USER=
SMTP_PASSWORD=
MANAGER_EMAIL=
